{
  "openapi": "3.2.0",
  "info": {
    "title": "Comet.Web | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "AuthEndpoints"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "HealthFeature"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "tags": [
          "AuditFeature"
        ],
        "operationId": "listAudit",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "targetType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "targetId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "AuditEntry": {
        "required": [
          "id",
          "timestamp",
          "accountId",
          "username",
          "ipAddress",
          "action",
          "targetType",
          "targetId",
          "summary",
          "before",
          "after"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "uint64"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "accountId": {
            "type": "integer",
            "format": "uint32"
          },
          "username": {
            "type": "string"
          },
          "ipAddress": {
            "type": [
              "null",
              "string"
            ]
          },
          "action": {
            "type": "string"
          },
          "targetType": {
            "type": [
              "null",
              "string"
            ]
          },
          "targetId": {
            "type": [
              "null",
              "string"
            ]
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "before": {
            "type": [
              "null",
              "string"
            ]
          },
          "after": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuditPage": {
        "required": [
          "items",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "gameDatabase",
          "accountDatabase",
          "gameServer",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "gameDatabase": {
            "type": "boolean"
          },
          "accountDatabase": {
            "type": "boolean"
          },
          "gameServer": {
            "type": "boolean"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "accountId",
          "username",
          "authority",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "uint32"
          },
          "username": {
            "type": "string"
          },
          "authority": {
            "type": "integer",
            "format": "int32"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        }
      },
      "Permission": {
        "enum": [
          "AdminArea",
          "ViewCatalogs",
          "ViewLive",
          "Moderate",
          "ManageCharacters",
          "ViewLogs",
          "ViewAudit",
          "Studio",
          "ManageAccounts"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "AuditFeature"
    },
    {
      "name": "AuthEndpoints"
    },
    {
      "name": "HealthFeature"
    }
  ]
}