{
  "openapi": "3.2.0",
  "info": {
    "title": "Comet.Web | v1",
    "version": "1.0.0"
  },
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "AuthEndpoints"
        ],
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "AuthEndpoints"
        ],
        "operationId": "me",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/health": {
      "get": {
        "tags": [
          "HealthFeature"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/audit": {
      "get": {
        "tags": [
          "AuditFeature"
        ],
        "operationId": "listAudit",
        "parameters": [
          {
            "name": "accountId",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "uint32"
            }
          },
          {
            "name": "action",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "targetType",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "targetId",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "from",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "to",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuditPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/items": {
      "get": {
        "tags": [
          "ItemsFeature"
        ],
        "operationId": "searchItems",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ItemCategory"
            }
          },
          {
            "name": "quality",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ItemQuality"
            }
          },
          {
            "name": "profession",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "uint8"
            }
          },
          {
            "name": "minLevel",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "uint8"
            }
          },
          {
            "name": "maxLevel",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "uint8"
            }
          },
          {
            "name": "type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 1
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int32",
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemSearchPage"
                }
              }
            }
          }
        }
      }
    },
    "/api/items/batch": {
      "get": {
        "tags": [
          "ItemsFeature"
        ],
        "operationId": "getItemsByIds",
        "parameters": [
          {
            "name": "ids",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CatalogItem"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/items/{id}": {
      "get": {
        "tags": [
          "ItemsFeature"
        ],
        "operationId": "getItem",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogItem"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ApiError": {
        "required": [
          "error"
        ],
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        }
      },
      "AuditEntry": {
        "required": [
          "id",
          "timestamp",
          "accountId",
          "username",
          "ipAddress",
          "action",
          "targetType",
          "targetId",
          "summary",
          "before",
          "after"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "uint64"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "accountId": {
            "type": "integer",
            "format": "uint32"
          },
          "username": {
            "type": "string"
          },
          "ipAddress": {
            "type": [
              "null",
              "string"
            ]
          },
          "action": {
            "type": "string"
          },
          "targetType": {
            "type": [
              "null",
              "string"
            ]
          },
          "targetId": {
            "type": [
              "null",
              "string"
            ]
          },
          "summary": {
            "type": [
              "null",
              "string"
            ]
          },
          "before": {
            "type": [
              "null",
              "string"
            ]
          },
          "after": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "AuditPage": {
        "required": [
          "items",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEntry"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "CatalogItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "uint32"
          },
          "name": {
            "type": "string"
          },
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "description": {
            "type": [
              "null",
              "string"
            ]
          },
          "icon": {
            "type": [
              "null",
              "string"
            ]
          },
          "groundIcon": {
            "type": [
              "null",
              "string"
            ]
          },
          "category": {
            "$ref": "#/components/schemas/ItemCategory"
          },
          "quality": {
            "$ref": "#/components/schemas/ItemQuality"
          },
          "requiredProfession": {
            "type": "integer",
            "format": "uint8"
          },
          "requiredWeaponSkill": {
            "type": "integer",
            "format": "uint8"
          },
          "requiredLevel": {
            "type": "integer",
            "format": "uint8"
          },
          "requiredGender": {
            "type": "integer",
            "format": "uint8"
          },
          "requiredStrength": {
            "type": "integer",
            "format": "uint16"
          },
          "requiredAgility": {
            "type": "integer",
            "format": "uint16"
          },
          "requiredVitality": {
            "type": "integer",
            "format": "uint16"
          },
          "requiredSpirit": {
            "type": "integer",
            "format": "uint16"
          },
          "monopoly": {
            "type": "integer",
            "format": "uint8"
          },
          "price": {
            "type": "integer",
            "format": "uint32"
          },
          "emoneyPrice": {
            "type": "integer",
            "format": "uint32"
          },
          "actionId": {
            "type": "integer",
            "format": "uint32"
          },
          "minAttack": {
            "type": "integer",
            "format": "uint16"
          },
          "maxAttack": {
            "type": "integer",
            "format": "uint16"
          },
          "defense": {
            "type": "integer",
            "format": "uint16"
          },
          "magicAttack": {
            "type": "integer",
            "format": "uint16"
          },
          "magicDefense": {
            "type": "integer",
            "format": "uint16"
          },
          "dexterity": {
            "type": "integer",
            "format": "uint16"
          },
          "dodge": {
            "type": "integer",
            "format": "uint16"
          },
          "life": {
            "type": "integer",
            "format": "uint16"
          },
          "mana": {
            "type": "integer",
            "format": "uint16"
          },
          "amount": {
            "type": "integer",
            "format": "uint16"
          },
          "amountLimit": {
            "type": "integer",
            "format": "uint16"
          },
          "gem1": {
            "type": "integer",
            "format": "uint8"
          },
          "gem2": {
            "type": "integer",
            "format": "uint8"
          },
          "attackRange": {
            "type": "integer",
            "format": "uint16"
          },
          "attackSpeed": {
            "type": "integer",
            "format": "uint16"
          },
          "stackLimit": {
            "type": "integer",
            "format": "uint32"
          }
        }
      },
      "HealthResponse": {
        "required": [
          "gameDatabase",
          "accountDatabase",
          "gameServer",
          "serverTime"
        ],
        "type": "object",
        "properties": {
          "gameDatabase": {
            "type": "boolean"
          },
          "accountDatabase": {
            "type": "boolean"
          },
          "gameServer": {
            "type": "boolean"
          },
          "serverTime": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ItemCategory": {
        "enum": [
          "Weapon",
          "Armor",
          "Headwear",
          "Necklace",
          "Ring",
          "Boots",
          "Shield",
          "Garment",
          "Steed",
          "Crop",
          "Bottle",
          "Arrow",
          "Gem",
          "Consumable",
          "Other"
        ]
      },
      "ItemQuality": {
        "enum": [
          "None",
          "Normal",
          "Refined",
          "Unique",
          "Elite",
          "Super"
        ]
      },
      "ItemSearchPage": {
        "required": [
          "items",
          "total",
          "assetsAvailable"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogItem"
            }
          },
          "total": {
            "type": "integer",
            "format": "int32"
          },
          "assetsAvailable": {
            "type": "boolean"
          }
        }
      },
      "LoginRequest": {
        "required": [
          "username",
          "password"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "MeResponse": {
        "required": [
          "accountId",
          "username",
          "authority",
          "permissions"
        ],
        "type": "object",
        "properties": {
          "accountId": {
            "type": "integer",
            "format": "uint32"
          },
          "username": {
            "type": "string"
          },
          "authority": {
            "type": "integer",
            "format": "int32"
          },
          "permissions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Permission"
            }
          }
        }
      },
      "Permission": {
        "enum": [
          "AdminArea",
          "ViewCatalogs",
          "ViewLive",
          "Moderate",
          "ManageCharacters",
          "ViewLogs",
          "ViewAudit",
          "Studio",
          "ManageAccounts"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "AuditFeature"
    },
    {
      "name": "AuthEndpoints"
    },
    {
      "name": "HealthFeature"
    },
    {
      "name": "ItemsFeature"
    }
  ]
}