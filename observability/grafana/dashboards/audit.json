{
  "uid": "fetih-audit",
  "title": "Audit",
  "description": "Web admin actions by action, target and staff member",
  "tags": ["fetih"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "action",
        "label": "Action prefix",
        "query": "",
        "current": { "text": "", "value": "" },
        "options": [{ "selected": true, "text": "", "value": "" }],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "targetType",
        "label": "Target type",
        "query": "",
        "current": { "text": "", "value": "" },
        "options": [{ "selected": true, "text": "", "value": "" }],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "targetId",
        "label": "Target ID",
        "query": "",
        "current": { "text": "", "value": "" },
        "options": [{ "selected": true, "text": "", "value": "" }],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "staff",
        "label": "Staff",
        "query": "",
        "current": { "text": "", "value": "" },
        "options": [{ "selected": true, "text": "", "value": "" }],
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "links": [
    {
      "type": "dashboards",
      "tags": ["fetih"],
      "asDropdown": false,
      "title": "Fetih",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "table",
      "title": "Web audit log",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 22 },
      "datasource": { "type": "mysql", "uid": "mysql" },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "mysql" },
          "rawSql": "SELECT ID, Timestamp, AccountID, Username AS Staff, IPAddress, Action, TargetType, TargetID, Summary, `Before`, `After` FROM fetih_game.web_audit WHERE $__timeFilter(Timestamp) AND ('$action' = '' OR Action LIKE CONCAT('$action', '%')) AND ('$targetType' = '' OR TargetType = '$targetType') AND ('$targetId' = '' OR TargetID = '$targetId') AND ('$staff' = '' OR Username LIKE CONCAT('%', '$staff', '%') OR CAST(AccountID AS CHAR) = '$staff') ORDER BY ID DESC LIMIT 500",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Staff" },
            "properties": [
              { "id": "links", "value": [{ "title": "Open staff player page", "url": "/admin/players/${__data.fields.AccountID}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "AccountID" },
            "properties": [
              { "id": "links", "value": [{ "title": "Open staff player page", "url": "/admin/players/${__data.fields.AccountID}" }] }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    }
  ]
}
