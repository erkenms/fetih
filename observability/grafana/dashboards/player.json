{
  "uid": "comet-player",
  "title": "Player",
  "description": "One character's or account's events. Link: /d/comet-player/player?var-characterId=<id>&var-accountId=<id>",
  "tags": [
    "comet"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "env",
        "label": "Environment",
        "query": "prod,test,dev",
        "multi": false,
        "includeAll": false,
        "current": {
          "text": "prod",
          "value": "prod"
        },
        "options": [
          {
            "selected": true,
            "text": "prod",
            "value": "prod"
          },
          {
            "selected": false,
            "text": "test",
            "value": "test"
          },
          {
            "selected": false,
            "text": "dev",
            "value": "dev"
          }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "characterId",
        "label": "Character ID",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          }
        ],
        "hide": 0,
        "description": "Regular expression; .* for any"
      },
      {
        "type": "textbox",
        "name": "accountId",
        "label": "Account ID",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "options": [
          {
            "selected": true,
            "text": ".*",
            "value": ".*"
          }
        ],
        "hide": 0,
        "description": "Regular expression; .* for any"
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "comet"
      ],
      "asDropdown": false,
      "title": "Comet",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Events",
      "id": 1,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({env=~\"$env|shared\", server=~\".+\", event!~\"packet\\\\.(in|out)\"} | json characterId, accountId | characterId=~\"$characterId\" | accountId=~\"$accountId\" [$__range]))",
          "refId": "A",
          "queryType": "instant"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
