    {
      "type": "timeseries",
      "title": "Save round time",
      "id": 11,
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(fetih_save_round_seconds_sum{env=\"$env\"}[$__rate_interval])) / sum(rate(fetih_save_round_seconds_count{env=\"$env\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "average",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(fetih_save_round_seconds_bucket{env=\"$env\"}[$__rate_interval])))",
          "refId": "B",
          "legendFormat": "p95",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
