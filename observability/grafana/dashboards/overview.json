          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(fetih_packets_sent_total{env=\"$env\"}[$__rate_interval])) or vector(0)",
          "refId": "B",
          "legendFormat": "out",
          "instant": false,
          "range": true
