{
  "uid": "fetih-items",
  "title": "Items",
  "description": "One item's life, current owner and duplicate detection",
  "tags": ["fetih"],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "30s",
  "time": { "from": "now-7d", "to": "now" },
  "templating": {
    "list": [
      {
        "type": "custom",
        "name": "env",
        "label": "Environment",
        "query": "prod,test,dev",
        "multi": false,
        "includeAll": false,
        "current": { "text": "prod", "value": "prod" },
        "options": [
          { "selected": true, "text": "prod", "value": "prod" },
          { "selected": false, "text": "test", "value": "test" },
          { "selected": false, "text": "dev", "value": "dev" }
        ],
        "hide": 0
      },
      {
        "type": "textbox",
        "name": "itemId",
        "label": "Item ID",
        "query": "",
        "current": { "text": "", "value": "" },
        "options": [{ "selected": true, "text": "", "value": "" }],
        "hide": 0
      }
    ]
  },
  "annotations": { "list": [] },
  "links": [
    {
      "type": "dashboards",
      "tags": ["fetih"],
      "asDropdown": false,
      "title": "Fetih",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "panels": [
    {
      "type": "table",
      "title": "Current owner",
      "id": 1,
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 5 },
      "datasource": { "type": "mysql", "uid": "mysql" },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "mysql" },
          "rawSql": "SELECT i.ItemID, i.TypeID, i.CharacterID, c.AccountID, COALESCE(c.Name, '(none)') AS Owner, i.Position, i.Package, i.StackAmount, i.Plus, i.Bless, i.Gem1, i.Gem2, i.Enchant, i.Locked FROM fetih_game.item i LEFT JOIN fetih_game.`character` c ON c.CharacterID = i.CharacterID WHERE '$itemId' <> '' AND i.ItemID = CAST('$itemId' AS UNSIGNED)",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Owner" },
            "properties": [
              { "id": "links", "value": [{ "title": "Open player", "url": "/admin/players/${__data.fields.AccountID}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "AccountID" },
            "properties": [
              { "id": "links", "value": [{ "title": "Open player", "url": "/admin/players/${__data.fields.AccountID}" }] }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "type": "logs",
      "title": "Item life",
      "id": 2,
      "gridPos": { "x": 0, "y": 5, "w": 24, "h": 14 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{env=\"$env\", server=\"game\", event=~\"item\\\\..+|trade\\\\.completed|booth\\\\.sold\"} |= \"$itemId\"",
          "queryType": "range",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Ascending",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "dedupStrategy": "none",
        "showLabels": false,
        "showCommonLabels": false
      }
    },
    {
      "type": "table",
      "title": "Duplicate live item IDs",
      "id": 3,
      "gridPos": { "x": 0, "y": 19, "w": 12, "h": 9 },
      "datasource": { "type": "mysql", "uid": "mysql" },
      "targets": [
        {
          "datasource": { "type": "mysql", "uid": "mysql" },
          "rawSql": "SELECT i.ItemID, COUNT(*) AS RowsCount, GROUP_CONCAT(DISTINCT c.Name ORDER BY c.Name SEPARATOR ', ') AS Owners, MIN(c.AccountID) AS AccountID FROM fetih_game.item i LEFT JOIN fetih_game.`character` c ON c.CharacterID = i.CharacterID GROUP BY i.ItemID HAVING COUNT(*) > 1 LIMIT 100",
          "format": "table",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "ItemID" },
            "properties": [
              { "id": "links", "value": [{ "title": "Inspect item", "url": "/grafana/d/fetih-items/items?var-itemId=${__data.fields.ItemID}" }] }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "Owners" },
            "properties": [
              { "id": "links", "value": [{ "title": "Open player", "url": "/admin/players/${__data.fields.AccountID}" }] }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    },
    {
      "type": "table",
      "title": "Multiple item.created events (non-stack)",
      "id": 4,
      "gridPos": { "x": 12, "y": 19, "w": 12, "h": 9 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum by (itemId) (count_over_time({env=\"$env\", server=\"game\", event=\"item.created\"} != \"stackAmount\" | json itemId | itemId!=\"\" [$__range])) > 1",
          "queryType": "instant",
          "format": "table",
          "refId": "A"
        }
      ],
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "Value #A": "Creations", "Value": "Creations" } } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Creations", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "itemId" },
            "properties": [
              { "id": "links", "value": [{ "title": "Inspect item", "url": "/grafana/d/fetih-items/items?var-itemId=${__data.fields.itemId}" }] }
            ]
          }
        ]
      },
      "options": { "showHeader": true }
    }
  ]
}
