// Tails the servers' JSON logs into Loki. Only server, level and event become labels;
// characterId, accountId and the rest stay in the line for `| json`. Packet trace lines
// (event packet.in / packet.out) are their own streams, so a selector can leave them out.

local.file_match "comet" {
  // Servers run from source, then servers in containers (compose profile deploy)
  path_targets = [
    {"__path__" = "/comet/src/Comet.*/logs/*.jsonl"},
    {"__path__" = "/comet/logs/*/*.jsonl"},
  ]
  sync_period  = "10s"
}

loki.source.file "comet" {
  targets    = local.file_match.comet.targets
  forward_to = [loki.process.comet.receiver]
}

loki.process "comet" {
  stage.json {
    expressions = {
      server = "server",
      level  = "level",
      event  = "event",
      ts     = "ts",
    }
  }

  stage.labels {
    values = {
      server = "",
      level  = "",
      event  = "",
    }
  }

  stage.timestamp {
    source = "ts"
    format = "RFC3339Nano"
  }

  stage.label_drop {
    values = ["filename"]
  }

  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
