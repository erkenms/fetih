# Copy to .env in the repository root and fill in. compose.yaml reads it; it stays out of git.

# The public domain the proxy serves the web on, with a Let's Encrypt certificate.
# localhost gives a self-signed one, for trying the stack out.
FETIH_DOMAIN=localhost

# MariaDB's root password, used by all three servers. MariaDB takes it only when it
# creates comet/sql/data; to change it later, change it in MariaDB as well.
DB_PASSWORD=password

# Grafana's admin login (viewers need none). Grafana takes it only on its first start.
GRAFANA_PASSWORD=admin

# The client built by client/build.cs
CLIENT_DIR=./_CLIENT/fetih
