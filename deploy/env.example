# Copy to deploy/.env and fill in. deploy/compose.yaml reads it; it stays out of git.

# The public domain the proxy serves the production web on, with a Let's Encrypt certificate.
# localhost gives a self-signed one, for trying the stack out.
FETIH_DOMAIN=localhost
FETIH_TEST_DOMAIN=test.localhost

# MariaDB's root password, used by all servers. MariaDB takes it only when it
# creates sql/data; to change it later, change it in MariaDB as well.
DB_PASSWORD=password

# Grafana's admin login (for editing). Grafana takes it only on its first start.
GRAFANA_PASSWORD=admin
GRAFANA_DB_PASSWORD=grafana

# Memory limit for the shared account server
ACCOUNT_MEM_LIMIT=256m

# The patch outputs built by tools/build.cs, served by the proxy (/srv/fetih/<env>/patch on the server)
PATCH_PROD_DIR=./_CLIENT/patch
PATCH_TEST_DIR=./_CLIENT/patch
DOWNLOAD_DIR=./_CLIENT/patch/download

# Discord webhook URL for Grafana alerts (optional in dev; alerts stay unrouted if unset)
# GRAFANA_DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Directory on the host where backup jobs write Prometheus textfile metrics (.prom)
# BACKUP_METRICS_DIR=./observability/node-exporter/textfile
