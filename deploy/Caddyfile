# The web's only way in. With public domains in FETIH_DOMAIN and FETIH_TEST_DOMAIN,
# Caddy gets and renews their Let's Encrypt certificates; with "localhost" it signs its own.
# Both sites serve the patches of both channels (/patch/prod/, /patch/test/) and the client
# download.
(patches) {
	# Objects are already compressed (or intentionally raw); skip encode on top of them
	handle /patch/*/objects/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle /patch/*/manifests/* {
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle /patch/*/manifest.json {
		encode zstd gzip
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}

	handle /download/fetih.zip {
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}

	handle /download/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}
}

{$FETIH_DOMAIN:localhost} {
	import patches

	handle {
		encode zstd gzip
		reverse_proxy fetih-prod-web:5820
	}
}

{$FETIH_TEST_DOMAIN:test.localhost} {
	import patches

	handle {
		encode zstd gzip
		reverse_proxy fetih-test-web:5820
	}
}
