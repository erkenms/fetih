# The web's only way in. With public domains in FETIH_DOMAIN and FETIH_TEST_DOMAIN,
# Caddy gets and renews their Let's Encrypt certificates; with "localhost" it signs its own.
# Both sites serve the patches (/patch/) and the launcher download (/download/Fetih.exe).
(patches) {
	# Objects are already compressed (or intentionally raw); skip encode on top of them
	handle /patch/objects/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle /patch/manifests/* {
		encode zstd gzip
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv
		file_server
	}

	handle /patch/manifest.json {
		encode zstd gzip
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}

	handle /download/Fetih.exe {
		header Cache-Control "no-cache"
		root * /srv
		file_server
	}
}

(grafana) {
	redir /grafana /grafana/ permanent
	handle /grafana/* {
		forward_auth {args[0]} {
			uri /auth/check
			copy_headers X-Webauth-User
		}
		reverse_proxy grafana:3000
	}
}

{$FETIH_DOMAIN:localhost} {
	import patches
	import grafana fetih-prod-web:5820

	handle {
		encode zstd gzip
		reverse_proxy fetih-prod-web:5820
	}
}

{$FETIH_TEST_DOMAIN:test.localhost} {
	import patches
	import grafana fetih-test-web:5820

	handle {
		encode zstd gzip
		reverse_proxy fetih-test-web:5820
	}
}
