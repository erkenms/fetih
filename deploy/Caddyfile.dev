{
	auto_https off
}

:8080 {
	redir /grafana /grafana/ permanent
	handle /grafana/* {
		forward_auth host.containers.internal:5820 {
			uri /auth/check
			copy_headers X-Webauth-User
		}
		reverse_proxy grafana:3000
	}

	handle /patch/* {
		root * /srv
		file_server
	}

	handle /download/Fetih.exe {
		root * /srv
		file_server
	}

	handle {
		reverse_proxy host.containers.internal:5820
	}
}
