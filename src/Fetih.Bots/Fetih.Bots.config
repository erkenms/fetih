// Bots log in through the account server like any player, so the account and game servers
// must be running. Accounts and characters are made on first use; each run puts the bots back
// on their group's spot. Override with --Groups:0:Count=300 or FETIH_BOTS_ variables.
{
    // GameHost replaces the realm's game address, which is the one players outside connect to
    "AccountServer": { "Host": "127.0.0.1", "Port": 9960, "Realm": "Mihenk", "GameHost": "127.0.0.1" },
    "AccountDatabase": { "Hostname": "localhost", "Schema": "fetih_account", "Username": "root", "Password": "password" },
    "GameDatabase": { "Hostname": "localhost", "Schema": "fetih_game", "Username": "root", "Password": "password" },
    "ClientDirectory": "../../../../../_CLIENT/fetih",
    "Password": "botpass1",
    // Bot accounts are <Prefix>NNNN@bots.local and their characters <Prefix>NNNN
    "Prefix": "Bot",
    // Logins are spread over this long, so a big run doesn't hit the servers all at once
    "LoginSpreadSeconds": 30,
    "ReportSeconds": 10,
    // Behaviors: hunt (kill monsters near the spot), wander (walk around it), jump (jump around
    // it), idle (stand there). Level is raised to at least this on each run.
    "Groups": [
        { "Behavior": "hunt", "Count": 5, "Map": 1002, "X": 434, "Y": 476, "Spread": 20, "Level": 15 },
        { "Behavior": "wander", "Count": 3, "Map": 1002, "X": 430, "Y": 380, "Spread": 15, "Level": 1 },
        { "Behavior": "jump", "Count": 2, "Map": 1002, "X": 430, "Y": 380, "Spread": 25, "Level": 1 }
    ]
}
