@page
@model Fetih.Web.Pages.Admin.Studio.Teleporters.IndexModel
@{
    ViewData["Title"] = "Işınlayıcılar (teleporters.json)";
}

<partial name="../_DataTabs" model='"teleporters"' />

@if (Model.StudioReadOnly)
{
    <div class="alert inline">Stüdyo salt okunur modda; değişiklikler kaydedilemez.</div>
}

<panel title="Işınlayıcılar (teleporters.json)" icon="711394">
    @if (Model.ConflictError != null)
    {
        <div class="alert inline">@Model.ConflictError</div>
    }
    @if (Model.Problems.Length > 0)
    {
        <div class="alert inline">
            Kaydetme doğrulama sorunları nedeniyle durduruldu:
            <ul class="problem-list">
                @foreach (var p in Model.Problems)
                {
                    <li>
                        @if (p.Entry is int idx) { <b>Satır @(idx + 1):</b> }
                        @p.Message
                    </li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-page-handler="Save">
        <input type="hidden" name="Hash" value="@Model.Hash">
        <div class="buttons" style="margin: 0 0 6px; justify-content: flex-start;">
            <button type="button" class="plain" data-add-row="teleporter-row" disabled="@Model.StudioReadOnly">+ Satır ekle</button>
            <button disabled="@Model.StudioReadOnly">Kaydet</button>
            <a class="button plain" href="/admin/studio/changes">Değişiklikler »</a>
            <span class="muted">@Model.Rows.Count ışınlayıcı · Hedef koordinatları kayıtta haritaya göre denetlenir.</span>
        </div>

        <div class="scroll">
            <table class="grid edit-grid">
                <thead>
                <tr><th>NPC ID</th><th>Ücret</th><th>Yüz</th><th>Metin / Kapatma</th><th>Hedefler (Ad, Harita, X, Y)</th><th>Sil</th></tr>
                </thead>
                <tbody data-rows="teleporter-row" data-next-index="@Model.Rows.Count">
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    var r = Model.Rows[i];
                    <tr data-row-index="@i">
                        <td class="@(Model.IsBad(i, "Id") ? "bad" : null)">
                            <input type="number" name="Rows[@i].Id" value="@r.Id" min="1" disabled="@Model.StudioReadOnly">
                            @if (!string.IsNullOrEmpty(r.Location))
                            {
                                <input type="hidden" name="Rows[@i].Location" value="@r.Location">
                                <div class="muted">@r.Location</div>
                            }
                        </td>
                        <td>
                            <input type="number" class="narrow" name="Rows[@i].Fare" value="@r.Fare" min="0" disabled="@Model.StudioReadOnly">
                        </td>
                        <td>
                            <input type="number" class="narrow" name="Rows[@i].Face" value="@r.Face" min="0" max="255" disabled="@Model.StudioReadOnly">
                        </td>
                        <td>
                            <textarea name="Rows[@i].Text" rows="2" placeholder="Karşılama metni (her satır bir paragraf)" disabled="@Model.StudioReadOnly">@r.Text</textarea>
                            <input type="text" name="Rows[@i].Close" value="@r.Close" placeholder="Kapatma seçeneği (isteğe bağlı)" style="margin-top: 2px" disabled="@Model.StudioReadOnly">
                        </td>
                        <td class="@(Model.IsBad(i, "Destinations") ? "bad" : null)">
                            <div class="dest-list" data-next-dest="@r.Destinations.Count">
                                @for (int j = 0; j < r.Destinations.Count; j++)
                                {
                                    var d = r.Destinations[j];
                                    <div class="dest-row @(Model.IsBadDest(i, j) ? "bad" : null)">
                                        <input type="text" name="Rows[@i].Destinations[@j].Name" value="@d.Name" placeholder="Hedef adı" disabled="@Model.StudioReadOnly">
                                        <input type="number" class="narrow" name="Rows[@i].Destinations[@j].Map" value="@d.Map" min="1" title="Harita" disabled="@Model.StudioReadOnly">
                                        <input type="number" class="narrow" name="Rows[@i].Destinations[@j].X" value="@d.X" min="0" title="X" disabled="@Model.StudioReadOnly">
                                        <input type="number" class="narrow" name="Rows[@i].Destinations[@j].Y" value="@d.Y" min="0" title="Y" disabled="@Model.StudioReadOnly">
                                        <label class="check" title="Hedefi sil">
                                            <input type="checkbox" name="Rows[@i].Destinations[@j].Delete" value="true" disabled="@Model.StudioReadOnly"> Sil
                                        </label>
                                    </div>
                                }
                            </div>
                            <button type="button" class="plain" data-add-dest disabled="@Model.StudioReadOnly">+ Hedef</button>
                        </td>
                        <td>
                            <input type="checkbox" name="Rows[@i].Delete" value="true" data-delete-row disabled="@Model.StudioReadOnly">
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="buttons">
            <button type="button" class="plain" data-add-row="teleporter-row" disabled="@Model.StudioReadOnly">+ Satır ekle</button>
            <button disabled="@Model.StudioReadOnly">Kaydet</button>
        </div>
    </form>
</panel>

<template id="teleporter-row">
    <tr data-row-index="__INDEX__">
        <td><input type="number" name="Rows[__INDEX__].Id" value="0" min="1"></td>
        <td><input type="number" class="narrow" name="Rows[__INDEX__].Fare" value="100" min="0"></td>
        <td><input type="number" class="narrow" name="Rows[__INDEX__].Face" value="1" min="0" max="255"></td>
        <td>
            <textarea name="Rows[__INDEX__].Text" rows="2" placeholder="Karşılama metni"></textarea>
            <input type="text" name="Rows[__INDEX__].Close" value="" placeholder="Kapatma seçeneği (isteğe bağlı)" style="margin-top: 2px">
        </td>
        <td>
            <div class="dest-list" data-next-dest="1">
                <div class="dest-row">
                    <input type="text" name="Rows[__INDEX__].Destinations[0].Name" value="" placeholder="Hedef adı">
                    <input type="number" class="narrow" name="Rows[__INDEX__].Destinations[0].Map" value="1002" min="1" title="Harita">
                    <input type="number" class="narrow" name="Rows[__INDEX__].Destinations[0].X" value="400" min="0" title="X">
                    <input type="number" class="narrow" name="Rows[__INDEX__].Destinations[0].Y" value="400" min="0" title="Y">
                    <label class="check" title="Hedefi sil">
                        <input type="checkbox" name="Rows[__INDEX__].Destinations[0].Delete" value="true"> Sil
                    </label>
                </div>
            </div>
            <button type="button" class="plain" data-add-dest>+ Hedef</button>
        </td>
        <td><input type="checkbox" name="Rows[__INDEX__].Delete" value="true" data-delete-row></td>
    </tr>
</template>

<template id="dest-template">
    <div class="dest-row">
        <input type="text" name="Rows[__INDEX__].Destinations[__DEST__].Name" value="" placeholder="Hedef adı">
        <input type="number" class="narrow" name="Rows[__INDEX__].Destinations[__DEST__].Map" value="1002" min="1" title="Harita">
        <input type="number" class="narrow" name="Rows[__INDEX__].Destinations[__DEST__].X" value="400" min="0" title="X">
        <input type="number" class="narrow" name="Rows[__INDEX__].Destinations[__DEST__].Y" value="400" min="0" title="Y">
        <label class="check" title="Hedefi sil">
            <input type="checkbox" name="Rows[__INDEX__].Destinations[__DEST__].Delete" value="true"> Sil
        </label>
    </div>
</template>

<script src="~/js/studio.js" asp-append-version="true" defer></script>
