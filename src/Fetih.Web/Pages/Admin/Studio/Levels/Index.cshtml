@page
@model Fetih.Web.Pages.Admin.Studio.Levels.IndexModel
@{
    ViewData["Title"] = "Seviyeler (levels.json)";
}

<partial name="../_DataTabs" model='"levels"' />

@if (Model.StudioReadOnly)
{
    <div class="alert inline">Stüdyo salt okunur modda; değişiklikler kaydedilemez.</div>
}

<panel title="Seviyeler (levels.json)" icon="711394">
    @if (Model.ConflictError != null)
    {
        <div class="alert inline">@Model.ConflictError</div>
    }
    @if (Model.Problems.Length > 0)
    {
        <div class="alert inline">
            Kaydetme doğrulama sorunları nedeniyle durduruldu:
            <ul class="problem-list">
                @foreach (var p in Model.Problems)
                {
                    <li>
                        @if (p.Entry is int idx) { <b>Satır @(idx + 1):</b> }
                        @p.Message
                    </li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-page-handler="Save">
        <input type="hidden" name="Hash" value="@Model.Hash">
        <div class="buttons" style="margin: 0 0 6px; justify-content: flex-start;">
            <button type="button" class="plain" data-add-row="level-row" disabled="@Model.StudioReadOnly">+ Satır ekle</button>
            <button disabled="@Model.StudioReadOnly">Kaydet</button>
            <a class="button plain" href="/admin/studio/changes">Değişiklikler »</a>
            <span class="muted">@Model.Rows.Count satır</span>
        </div>

        <div class="scroll">
            <table class="grid edit-grid">
                <thead>
                <tr><th>Seviye</th><th>Deneyim</th><th>Süre (UpLevTime)</th><th>Sil</th></tr>
                </thead>
                <tbody data-rows="level-row" data-next-index="@Model.Rows.Count">
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    var r = Model.Rows[i];
                    <tr>
                        <td class="@(Model.IsBad(i, "Level") ? "bad" : null)">
                            <input type="number" class="narrow" name="Rows[@i].Level" value="@r.Level" min="1" max="255" disabled="@Model.StudioReadOnly">
                        </td>
                        <td class="@(Model.IsBad(i, "Experience") ? "bad" : null)">
                            <input type="number" class="wide" name="Rows[@i].Experience" value="@r.Experience" min="0" disabled="@Model.StudioReadOnly">
                        </td>
                        <td class="@(Model.IsBad(i, "UpLevTime") ? "bad" : null)">
                            <input type="number" name="Rows[@i].UpLevTime" value="@r.UpLevTime" min="0" disabled="@Model.StudioReadOnly">
                        </td>
                        <td>
                            <input type="checkbox" name="Rows[@i].Delete" value="true" data-delete-row disabled="@Model.StudioReadOnly">
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="buttons">
            <button type="button" class="plain" data-add-row="level-row" disabled="@Model.StudioReadOnly">+ Satır ekle</button>
            <button disabled="@Model.StudioReadOnly">Kaydet</button>
        </div>
    </form>
</panel>

<template id="level-row">
    <tr>
        <td><input type="number" class="narrow" name="Rows[__INDEX__].Level" value="1" min="1" max="255"></td>
        <td><input type="number" class="wide" name="Rows[__INDEX__].Experience" value="100" min="0"></td>
        <td><input type="number" name="Rows[__INDEX__].UpLevTime" value="1" min="0"></td>
        <td><input type="checkbox" name="Rows[__INDEX__].Delete" value="true" data-delete-row></td>
    </tr>
</template>

<script src="~/js/studio.js" asp-append-version="true" defer></script>
