@page
@model Fetih.Web.Pages.Admin.Studio.Talkers.IndexModel
@{
    ViewData["Title"] = "Konuşmacılar (talkers.json)";
}

<partial name="../_DataTabs" model='"talkers"' />

@if (Model.StudioReadOnly)
{
    <div class="alert inline">Stüdyo salt okunur modda; değişiklikler kaydedilemez.</div>
}

<panel title="Konuşmacılar (talkers.json)" icon="711394">
    @if (Model.ConflictError != null)
    {
        <div class="alert inline">@Model.ConflictError</div>
    }
    @if (Model.Problems.Length > 0)
    {
        <div class="alert inline">
            Kaydetme doğrulama sorunları nedeniyle durduruldu:
            <ul class="problem-list">
                @foreach (var p in Model.Problems)
                {
                    <li>
                        @if (p.Entry is int idx) { <b>Satır @(idx + 1):</b> }
                        @p.Message
                    </li>
                }
            </ul>
        </div>
    }

    <form method="post" asp-page-handler="Save">
        <input type="hidden" name="Hash" value="@Model.Hash">
        <div class="buttons" style="margin: 0 0 6px; justify-content: flex-start;">
            <button type="button" class="plain" data-add-row="talker-row" disabled="@Model.StudioReadOnly">+ Satır ekle</button>
            <button disabled="@Model.StudioReadOnly">Kaydet</button>
            <a class="button plain" href="/admin/studio/changes">Değişiklikler »</a>
            <span class="muted">@Model.Rows.Count konuşmacı</span>
        </div>

        <div class="scroll">
            <table class="grid edit-grid">
                <thead>
                <tr><th>NPC ID</th><th>Yüz</th><th>Metin (her satır bir paragraf)</th><th>Yanıt</th><th>Sil</th></tr>
                </thead>
                <tbody data-rows="talker-row" data-next-index="@Model.Rows.Count">
                @for (int i = 0; i < Model.Rows.Count; i++)
                {
                    var r = Model.Rows[i];
                    <tr>
                        <td class="@(Model.IsBad(i, "Id") ? "bad" : null)">
                            <input type="number" name="Rows[@i].Id" value="@r.Id" min="1" disabled="@Model.StudioReadOnly">
                            @if (!string.IsNullOrEmpty(r.Location))
                            {
                                <input type="hidden" name="Rows[@i].Location" value="@r.Location">
                                <div class="muted">@r.Location</div>
                            }
                        </td>
                        <td>
                            <input type="number" class="narrow" name="Rows[@i].Face" value="@r.Face" min="0" max="255" disabled="@Model.StudioReadOnly">
                        </td>
                        <td class="@(Model.IsBad(i, "Text") ? "bad" : null)">
                            <textarea name="Rows[@i].Text" rows="2" disabled="@Model.StudioReadOnly">@r.Text</textarea>
                        </td>
                        <td class="@(Model.IsBad(i, "Reply") ? "bad" : null)">
                            <input type="text" name="Rows[@i].Reply" value="@r.Reply" disabled="@Model.StudioReadOnly">
                        </td>
                        <td>
                            <input type="checkbox" name="Rows[@i].Delete" value="true" data-delete-row disabled="@Model.StudioReadOnly">
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        <div class="buttons">
            <button type="button" class="plain" data-add-row="talker-row" disabled="@Model.StudioReadOnly">+ Satır ekle</button>
            <button disabled="@Model.StudioReadOnly">Kaydet</button>
        </div>
    </form>
</panel>

<template id="talker-row">
    <tr>
        <td><input type="number" name="Rows[__INDEX__].Id" value="0" min="1"></td>
        <td><input type="number" class="narrow" name="Rows[__INDEX__].Face" value="0" min="0" max="255"></td>
        <td><textarea name="Rows[__INDEX__].Text" rows="2"></textarea></td>
        <td><input type="text" name="Rows[__INDEX__].Reply" value=""></td>
        <td><input type="checkbox" name="Rows[__INDEX__].Delete" value="true" data-delete-row></td>
    </tr>
</template>

<script src="~/js/studio.js" asp-append-version="true" defer></script>
