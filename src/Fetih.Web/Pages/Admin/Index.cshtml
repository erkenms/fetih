@page
@model Fetih.Web.Pages.Admin.IndexModel
@{
    ViewData["Title"] = "Yönetim paneli";
}
<panel title="Sunucu Durumu" icon="724426">
    <div hx-get="@Url.Page("Index", "Status")" hx-trigger="every 5s">
        <partial name="/Pages/Admin/Server/_Status.cshtml" model="Model.Status" />
    </div>
    @if (User.Has(Permission.ServerControl))
    {
        <p style="margin: 6px 0 0"><a href="/admin/server">Sunucu kontrolüne git »</a></p>
    }
</panel>
<div class="sections">
    @foreach (var group in AdminMenu.For(User))
    {
        <panel title="@group.Title">
            <nav class="menu">
                @foreach (var link in group.Links)
                {
                    <a href="@link.Url">» @link.Text</a>
                }
            </nav>
        </panel>
    }
</div>
