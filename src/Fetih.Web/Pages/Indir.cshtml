@page "/indir"
@model IndirModel
@{
    ViewData["Title"] = "İndir";
}

<panel title="İstemciyi İndir" icon="724426">
    <p>Fetih Online'a katılmak için klasik <b>5619</b> oyun istemcisini indir. Tek dosya:
        oyunu kurar, güncel tutar ve başlatır.</p>
    <div class="buttons" style="justify-content: flex-start">
        <a class="button" href="/download/Fetih.exe" download>Fetih.exe indir</a>
    </div>
</panel>

<panel title="Başlangıç" icon="711394">
    <ol style="margin: 0; padding-left: 18px">
        <li>Siteden bir <a href="/kayit">hesap oluştur</a>.</li>
        <li><code>Fetih.exe</code> dosyasını indirip aç. Windows uyarırsa "Ek bilgi", sonra "Yine de çalıştır".</li>
        <li>Oyun indirilince <b>Oyna</b>'ya bas, e-posta ve şifrenle giriş yap.</li>
    </ol>
</panel>
