@inject Fetih.Web.Game.GameRpc Game
@{
    string path = Context.Request.Path;
    bool signedIn = User.Identity?.IsAuthenticated == true;
    string On(string url, bool prefix = false) =>
        prefix
            ? (path.StartsWith(url, StringComparison.OrdinalIgnoreCase) ? "on" : "")
            : (string.Equals(path, url, StringComparison.OrdinalIgnoreCase) ? "on" : "");
}
<!doctype html>
<html lang="tr">
<head>
    <partial name="_Head" />
</head>
<body>
<div class="site">
    <div class="site-top">
        <span>
            @if (Game.Connected)
            {
                <span class="online">Sunucu açık</span>
            }
            else
            {
                <span class="offline">Sunucu kapalı</span>
            }
        </span>
        <span>
            @if (signedIn)
            {
                <text>Giriş yapan: <b>@User.Username()</b> | </text>
                <a href="/hesabim">Hesabım</a><text> | </text>
                @if (User.Has(Permission.AdminArea))
                {
                    <a href="/admin">Yönetim paneli</a><text> | </text>
                }
                <form method="post" asp-page="/Giris" asp-page-handler="Cikis"><button>Çıkış</button></form>
            }
            else
            {
                <a href="/giris">Giriş</a><text> | </text>
                <a href="/kayit">Kayıt Ol</a>
            }
        </span>
    </div>

    <header class="site-header">
        <a class="logo" href="/">Fetih</a>
        <div class="tagline">Klasik 5619 sunucusu</div>
    </header>

    <nav class="site-menu" aria-label="Ana menü">
        <a class="@On("/")" href="/">Ana Sayfa</a>
        <a class="@On("/haberler", prefix: true)" href="/haberler">Haberler</a>
        <a class="@On("/siralama", prefix: true)" href="/siralama">Sıralamalar</a>
        <a class="@On("/indir", prefix: true)" href="/indir">İndir</a>
        @if (signedIn)
        {
            <a class="@On("/hesabim", prefix: true)" href="/hesabim">Hesabım</a>
        }
        else
        {
            <a class="@On("/kayit", prefix: true)" href="/kayit">Kayıt Ol</a>
        }
    </nav>

    <div class="site-columns">
        <aside class="site-side">
            <big-button kind="gold" href="/indir" note="İstemci, sürüm 5619">Oyunu İndir</big-button>
            @if (signedIn)
            {
                <big-button kind="red" href="/hesabim" note="Hesap ayarların">Hesabım</big-button>
            }
            else
            {
                <big-button kind="red" href="/kayit" note="Ücretsiz, bir dakika sürer">Hesap Oluştur</big-button>
            }
            @await RenderSectionAsync("Side", required: false)
        </aside>
        <main class="site-main">
            <partial name="_Flash" />
            @RenderBody()
        </main>
    </div>

    <div class="site-foot">Fetih Online</div>
</div>
</body>
</html>
