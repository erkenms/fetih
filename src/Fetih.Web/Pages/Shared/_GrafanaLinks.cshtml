@inject Fetih.Web.Features.Dashboard.ObservabilityOptions Observability
@if (User.Has(Permission.ViewLogs))
{
    string env = string.IsNullOrWhiteSpace(Observability.Environment) ? "dev" : Observability.Environment;
    <h3>Kayıtlar</h3>
    <a href="@Grafana.OverviewUrl(env)">» Genel bakış</a>
    <a href="@Grafana.AdminUrl(env)">» Yönetim özeti</a>
    <a href="@Grafana.EconomyUrl(env)">» Ekonomi</a>
    <a href="@Grafana.ChatUrl(env: env)">» Sohbet günlüğü</a>
    <a href="@Grafana.ItemsUrl(env: env)">» Eşya geçmişi</a>
    <a href="@Grafana.PlayerUrl(env: env)">» Oyuncu kayıtları</a>
    <a href="@Grafana.PacketsUrl(env: env)">» Paketler</a>
    <a href="@Grafana.AuditUrl()">» Denetim kaydı</a>
}
