<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OpenApiGenerateDocuments>false</OpenApiGenerateDocuments>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../../web/src/api</OpenApiDocumentsDirectory>
    <OpenApiGenerateDocumentsOptions>--file-name openapi</OpenApiGenerateDocumentsOptions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fetih.Account\Fetih.Account.csproj" />
    <ProjectReference Include="..\Fetih.Game\Fetih.Game.csproj" />
    <ProjectReference Include="..\Fetih.TestClient\Fetih.TestClient.csproj" />
    <ProjectReference Include="..\Fetih.Core\Fetih.Core.csproj" />
    <ProjectReference Include="..\Fetih.Network\Fetih.Network.csproj" />
    <ProjectReference Include="..\Fetih.Shared\Fetih.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="11.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog.Extensions.Logging" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Fetih.Web.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Fetih.Web.Tests" />
  </ItemGroup>

</Project>
